# Cloud Functions parameters. Non-secret configuration only — this file is
# committed so CI deploys use the same values as a local deploy. Secrets
# (PASSWORD_ENCRYPTION_KEY, SMTP_USER, SMTP_PASS) live in Secret Manager.

APP_URL=https://password.initiolearning.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Hourly generation limit for callers not on an elevated allowlist tier.
RATE_LIMIT_PUBLIC_PER_HOUR=1000

# Proxy trust. Both must be set before any allowlist entry's generation limit
# takes effect; until then every caller gets the public limit above. Determine
# the values with GET /api/whoami — see "Operating the API" in the README.
RATE_LIMIT_PROXY_HOPS=
RATE_LIMIT_TRUSTED_PROXIES=
